[Unit]
Description=grout DPDK graph router
# grout PROVIDES the network on this node, so it is ordered like FRR: after
# network-pre.target and before network.target. Ordering it *after*
# network.target instead created a cycle -- FRR is Before=network.target and
# depends on grout, so network.target waited on FRR, FRR waited on grout, and
# grout waited on network.target. systemd cannot break a cycle it cannot order,
# so it dropped grout's start job entirely: the container came up, nothing
# reported an error, and the CRA simply timed out waiting for a grout that was
# never going to start.
After=network-pre.target
Before=network.target

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=/etc/default/grout

# Test-mode (no hugepages) by default so the flavor runs on a plain node / in
# the CRA netns without host DPDK tuning. For a production fast path drop the
# `-t` (set ARGS in /etc/default/grout) once hugepages + vfio-pci are prepared.
Restart=on-failure
RestartSec=5

ExecStart=/usr/local/bin/grout $ARGS
ExecStartPost=/usr/local/bin/grout-wait-ready

[Install]
WantedBy=multi-user.target
